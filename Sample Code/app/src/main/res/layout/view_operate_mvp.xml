<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F3FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/operate_mvp_menu_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#162A36"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/operate_mvp_operate_label"
                android:layout_width="66dp"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="OPERATE"
                android:textColor="#162A36"
                android:textSize="11sp" />

            <Button
                android:id="@+id/operate_mvp_sources_button"
                android:layout_width="74dp"
                android:layout_height="40dp"
                android:background="@drawable/operate_mvp_button"
                android:text="SOURCES  ▾"
                android:textColor="#162A36"
                android:textSize="11sp" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView android:id="@+id/operate_mvp_cendence_status" android:layout_width="76dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_controller" android:drawablePadding="2dp" android:gravity="center" android:text="RC --" android:textColor="#667B87" android:textSize="10sp" />
            <TextView android:id="@+id/operate_mvp_aircraft_status" android:layout_width="76dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_aircraft" android:drawablePadding="2dp" android:gravity="center" android:text="AIR --" android:textColor="#667B87" android:textSize="10sp" />
            <TextView android:id="@+id/operate_mvp_connection_attention" android:layout_width="14dp" android:layout_height="40dp" android:gravity="center" android:text="?" android:textColor="#E29A22" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/operate_mvp_connection_detail_button" android:layout_width="20dp" android:layout_height="40dp" android:clickable="true" android:contentDescription="Open connection details" android:focusable="true" android:gravity="center" android:text="▾" android:textColor="#162A36" android:textSize="14sp" />
            <TextView android:id="@+id/operate_mvp_link_status" android:layout_width="50dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_link" android:drawablePadding="2dp" android:gravity="center" android:text="LINK --" android:textColor="#667B87" android:textSize="9sp" />
            <TextView android:id="@+id/operate_mvp_rtk_status" android:layout_width="58dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_gps" android:drawablePadding="2dp" android:gravity="center" android:text="RTK --" android:textColor="#667B87" android:textSize="9sp" />
            <TextView android:id="@+id/operate_mvp_gps_status" android:layout_width="52dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_gps" android:drawablePadding="2dp" android:gravity="center" android:text="GPS --" android:textColor="#667B87" android:textSize="9sp" />
            <TextView android:id="@+id/operate_mvp_positioning_attention" android:layout_width="14dp" android:layout_height="40dp" android:gravity="center" android:text="?" android:textColor="#E29A22" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/operate_mvp_positioning_detail_button" android:layout_width="20dp" android:layout_height="40dp" android:clickable="true" android:contentDescription="Open positioning details" android:focusable="true" android:gravity="center" android:text="▾" android:textColor="#162A36" android:textSize="14sp" />
            <TextView android:id="@+id/operate_mvp_rc_battery_status" android:layout_width="48dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_battery" android:drawablePadding="2dp" android:gravity="center" android:text="RC --" android:textColor="#667B87" android:textSize="9sp" />
            <TextView android:id="@+id/operate_mvp_battery_one_status" android:layout_width="46dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_battery" android:drawablePadding="2dp" android:gravity="center" android:text="B1 --" android:textColor="#667B87" android:textSize="9sp" />
            <TextView android:id="@+id/operate_mvp_battery_two_status" android:layout_width="46dp" android:layout_height="40dp" android:drawableLeft="@drawable/operate_mvp_status_battery" android:drawablePadding="2dp" android:gravity="center" android:text="B2 --" android:textColor="#667B87" android:textSize="9sp" />
            <TextView android:id="@+id/operate_mvp_power_attention" android:layout_width="14dp" android:layout_height="40dp" android:gravity="center" android:text="?" android:textColor="#E29A22" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/operate_mvp_power_detail_button" android:layout_width="20dp" android:layout_height="40dp" android:clickable="true" android:contentDescription="Open power details" android:focusable="true" android:gravity="center" android:text="▾" android:textColor="#162A36" android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/operate_mvp_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <FrameLayout
                android:id="@+id/operate_mvp_video_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <SurfaceView
                android:id="@+id/operate_mvp_video_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/operate_mvp_primary_warning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="false">

                <TextView
                    android:id="@+id/operate_mvp_no_signal_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NO SIGNAL"
                    android:textColor="#FF3145"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/operate_mvp_no_signal_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="WAITING FOR CAMERA FEED"
                    android:textColor="#FF3145"
                    android:textSize="12sp" />
            </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/operate_mvp_page_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:paddingTop="5dp">

            <include layout="@layout/operate_mvp_telemetry_cell" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/operate_mvp_menu_panel"
        android:layout_width="260dp"
        android:layout_height="270dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/operate_mvp_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:paddingLeft="10dp" android:text="MENU" android:textColor="#667B87" android:textSize="12sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:id="@+id/operate_mvp_menu_operate" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="left|center_vertical" android:paddingLeft="10dp" android:text="OPERATE" android:textColor="#162A36" />
                <Button android:id="@+id/operate_mvp_menu_mission" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="left|center_vertical" android:paddingLeft="10dp" android:text="MISSION" android:textColor="#162A36" />
                <Button android:id="@+id/operate_mvp_menu_transport" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="left|center_vertical" android:paddingLeft="10dp" android:text="TRANSPORT" android:textColor="#162A36" />
                <Button android:id="@+id/operate_mvp_menu_dji_connection" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="left|center_vertical" android:paddingLeft="10dp" android:text="DJI CONNECTION" android:textColor="#162A36" />
                <Button android:id="@+id/operate_mvp_menu_settings" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="left|center_vertical" android:paddingLeft="10dp" android:text="SETTINGS" android:textColor="#162A36" />
                <Button android:id="@+id/operate_mvp_menu_demos" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="left|center_vertical" android:paddingLeft="10dp" android:text="SAMPLE" android:textColor="#162A36" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/operate_mvp_source_panel"
        android:layout_gravity="left|top"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="94dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/operate_mvp_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SOURCES" android:textColor="#667B87" android:textSize="11sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="PRIMARY" android:textColor="#162A36" android:textSize="13sp" />
        <TextView android:id="@+id/operate_mvp_primary_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="#162A36" android:textSize="15sp" />
        <TextView android:id="@+id/operate_mvp_primary_stream_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="NO SIGNAL" android:textColor="#FF3145" android:textSize="12sp" />
        <TextView android:id="@+id/operate_mvp_primary_frame_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="NO FRAME RECEIVED" android:textColor="#667B87" android:textSize="11sp" />
        <Button android:id="@+id/operate_mvp_primary_selector" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:gravity="left|center_vertical" android:text="SELECT PRIMARY  ▾" android:textColor="#162A36" android:textSize="12sp" />
        <LinearLayout android:id="@+id/operate_mvp_primary_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/operate_mvp_sources_left_fpv" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="left|center_vertical" android:text="LEFT CAM + FPV" android:textColor="#162A36" android:textSize="12sp" />
            <Button android:id="@+id/operate_mvp_sources_right_fpv" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="left|center_vertical" android:text="RIGHT CAM + FPV" android:textColor="#162A36" android:textSize="12sp" />
            <Button android:id="@+id/operate_mvp_sources_left_right" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="left|center_vertical" android:text="LEFT CAM + RIGHT CAM" android:textColor="#162A36" android:textSize="12sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#C5D3DB" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="FPV" android:textColor="#162A36" android:textSize="13sp" />
        <TextView android:id="@+id/operate_mvp_fpv_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="#162A36" android:textSize="15sp" />
        <TextView android:id="@+id/operate_mvp_fpv_stream_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="UNAVAILABLE" android:textColor="#667B87" android:textSize="12sp" />
        <TextView android:id="@+id/operate_mvp_fpv_frame_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="NO FRAME RECEIVED" android:textColor="#667B87" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/operate_mvp_gimbal_panel"
        android:layout_gravity="right|bottom"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/operate_mvp_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView android:id="@+id/operate_mvp_gimbal_pitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PITCH   --" android:textColor="#162A36" android:textSize="14sp" />
        <TextView android:id="@+id/operate_mvp_gimbal_roll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ROLL     --" android:textColor="#162A36" android:textSize="14sp" />
        <TextView android:id="@+id/operate_mvp_gimbal_yaw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="YAW      --" android:textColor="#162A36" android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/operate_mvp_detail_panel"
        android:layout_gravity="left|top"
        android:layout_width="360dp"
        android:layout_height="330dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/operate_mvp_panel"
        android:elevation="8dp"
        android:fillViewport="true"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/operate_mvp_detail_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STATUS" android:textColor="#667B87" android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/operate_mvp_readiness_connection" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="LINK" android:textColor="#162A36" android:textSize="10sp" />
                <Button android:id="@+id/operate_mvp_readiness_navigation" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="NAV" android:textColor="#162A36" android:textSize="10sp" />
                <Button android:id="@+id/operate_mvp_readiness_power" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="POWER" android:textColor="#162A36" android:textSize="10sp" />
                <Button android:id="@+id/operate_mvp_readiness_safety" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="SAFETY" android:textColor="#162A36" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/operate_mvp_detail_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="--" android:textColor="#243946" android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/operate_mvp_detail_checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
