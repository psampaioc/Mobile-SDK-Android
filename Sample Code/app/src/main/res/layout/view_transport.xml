<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F3FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRANSPORT"
            android:textColor="#1B344A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transport_explanation"
            android:textColor="#40596E"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/transport_edge_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/transport_edge_host_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
        <Button
            android:id="@+id/transport_add_ip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/transport_add_ip" />
        <Button
            android:id="@+id/transport_remove_ip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/transport_remove_ip" />
        <Button
            android:id="@+id/transport_use_ip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/transport_use_ip" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transport_saved_ips"
            android:textColor="#1B344A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/transport_ip_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/transport_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textColor="#40596E"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="PRIMARY TRANSPORT • LOCAL DASHBOARD"
            android:textColor="#1B344A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/transport_primary_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F7FBFE"
            android:padding="14dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/transport_input_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F7FBFE"
            android:padding="12dp"
            android:textColor="#1B344A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/transport_pipeline_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F7FBFE"
            android:padding="12dp"
            android:textColor="#1B344A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/transport_udp_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F7FBFE"
            android:padding="12dp"
            android:textColor="#1B344A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/transport_evidence_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="#F7FBFE"
            android:padding="12dp"
            android:textColor="#40596E"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
